{
  "name": "pasivos-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:aspire": "ng serve --port 4200",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "prebuild:prod": "node scripts/set-version.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:Pasivos_Frontend": "node dist/Pasivos_Frontend/server/server.mjs",
    "generate:api": "openapi-generator-cli generate -c openapi-config.json --skip-validate-spec",
    "generate:api:clean": "rm -rf src/api && npm run generate:api",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/animations": "21.2.5",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/platform-browser": "^21.2.5",
    "@angular/platform-server": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@angular/ssr": "^21.2.3",
    "@fontsource/roboto": "5.2.10",
    "@fortawesome/fontawesome-free": "7.2.0",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "highcharts": "^12.5.0",
    "highcharts-angular": "^5.4.0",
    "ngx-toastr": "20.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.5",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.30.2",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.3.1",
    "eslint": "^10.0.3",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.0.8"
  }
}
