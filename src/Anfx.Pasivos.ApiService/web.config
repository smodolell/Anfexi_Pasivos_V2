<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS: ASP.NET Core Module v2 (ANCM v2) — requerido en el servidor.
  Instalar: https://dotnet.microsoft.com/download/dotnet/10.0  (Hosting Bundle)
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\Anfx.Pasivos.ApiService.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!--
            NO poner secretos aquí. Configurar en el servidor como variables
            de entorno del Application Pool o como User Secrets:
              ConnectionStrings__DefaultConnection
              JwtSettings__SecretKey
          -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
